DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=pmdap
POSTGRES_USER=pmdap
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
DJANGO_CACHE_URL=redis://localhost:6379/2
REDIS_HOST_PORT=6379

# Identity images remain private and are limited to 10 MiB by default.
IDENTITY_FILE_MAX_BYTES=10485760

# Medical originals remain private. Defaults: 25 MiB and 40 megapixels.
MEDICAL_FILE_MAX_BYTES=26214400
MEDICAL_IMAGE_MAX_PIXELS=40000000

# M7 PDF text usability, page bound, and bounded retry policy.
PDF_TEXT_MIN_CHARS=80
PDF_TEXT_MIN_PAGE_CHARS=40
PDF_TEXT_MIN_TEXT_PAGE_RATIO=0.5
PDF_MAX_PAGES=250
PDF_EXTRACTION_MAX_RETRIES=3
PDF_EXTRACTION_RETRY_BASE_SECONDS=5
PDF_EXTRACTION_SOFT_TIME_LIMIT=1500
PDF_EXTRACTION_TIME_LIMIT=1800

# M8 CPU OCR. PP-OCRv5 ar model recognizes Arabic, Persian, English, and digits.
OCR_ENGINE=paddleocr
OCR_TEXT_DETECTION_MODEL_NAME=PP-OCRv5_mobile_det
OCR_TEXT_RECOGNITION_MODEL_NAME=arabic_PP-OCRv5_mobile_rec
# Optional immutable local-model overrides; blank uses the preloaded Paddle cache.
OCR_TEXT_DETECTION_MODEL_DIR=
OCR_TEXT_RECOGNITION_MODEL_DIR=
OCR_PDF_RENDER_DPI=300
OCR_PDF_RENDER_MAX_DPI=400
OCR_MAX_IMAGE_PIXELS=20000000
OCR_MAX_WIDTH=6000
OCR_MAX_HEIGHT=6000
OCR_MAX_TEXT_CHARS_PER_PAGE=100000
OCR_MAX_TEXT_CHARS_PER_DOCUMENT=2000000
OCR_TEXT_MIN_MEANINGFUL_CHARS=1
OCR_TASK_MAX_RETRIES=3
OCR_TASK_RETRY_BASE_SECONDS=10
OCR_TASK_SOFT_TIME_LIMIT=1500
OCR_TASK_TIME_LIMIT=1800
OCR_WORKER_CONCURRENCY=1
